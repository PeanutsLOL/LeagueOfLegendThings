Buffs: {
	LethalTempo: {
		DisplayName: 致命节奏
		Description: 提高攻击速度；连续命中后发射额外子弹。
	}

	Conqueror: {
		DisplayName: 征服者
		Description: 连续攻击对目标造成更多伤害，并根据造成的伤害恢复生命值。
	}

	FleetFootwork: {
		DisplayName: 迅捷步法
		Description: 攻击时治疗并短暂获得移动速度提升。
	}

	AbsorbLife: {
		DisplayName: 吸收生命力
		Description: 攻击命中时吸取生命恢复自身。
	}

	Triumph: {
		DisplayName: 凯旋
		Description: 击杀后治疗并在击败Boss后额外获得战利品。
	}

	PresenceOfMind: {
		DisplayName: 气定神闲
		Description: 攻击或击杀时恢复法力。
	}

	LegendAlacrity: {
		DisplayName: 传说：欢欣
		Description: 每层增加攻击速度（最多6层）。
	}

	LegendBloodline: {
		DisplayName: 传说：血统
		Description: 每层提供吸血效果，满层时有额外最大生命加成。
	}

	LegendHaste: {
		DisplayName: 传说：急速
		Description: 每层减少药水冷却时间。
	}

	CoupDeGrace: {
		DisplayName: 致命一击
		Description: 对低于40%生命值的Boss造成额外伤害。
	}

	CutDown: {
		DisplayName: 砍倒
		Description: 对高于60%生命值的Boss造成更多伤害。
	}

	LastStand: {
		DisplayName: 坚毅不倒
		Description: 对Boss的伤害会随失去生命增加。
	}

	SummonAery: {
		DisplayName: 召唤：艾黎
		Description: 召唤艾黎协助你。
	}

	GlacialAugment: {
		DisplayName: 冰川增幅
		Description: 冰系伤害命中时造成强烈减速效果（有冷却）。
	}

	UnsealedSpellbook: {
		DisplayName: 解封的秘籍
		Description: 增加额外饰品栏、外观栏和染色栏位。
	}

	FirstStrike: {
		DisplayName: 先攻
		Description: 记录3秒内对同一目标造成的伤害；触发后造成额外伤害并进入冷却。
	}

	PressTheAttack: {
