UI: {
	Runes: {
		Labels: {
			MainButton: 符文
			PanelTitle: 符文选择
			ButtonLocked: 锁定
			ButtonUnlocked: 解锁
		}

		HintNoRunes: 尚未选择符文！点击设置按钮上方的 [符文] 按钮选择你的符文路线和基石。
		HintMayhemToggle: 提示：可以在 设置 → 符文配置 → 启用海克斯大乱斗符文 中切换至大乱斗模式。

		Path: {
			Precision: {
				Name: 精密
				Desc: 成为一个传说
			}

			Domination: {
				Name: 主宰
				Desc: 猎杀并消灭猎物
			}

			Sorcery: {
				Name: 巫术
				Desc: 释放毁灭
			}

			Resolve: {
				Name: 坚决
				Desc: 永生
			}

			Inspiration: {
				Name: 启迪
				Desc: 智胜区区凡人
			}
		}

		Desc: {
			Press_the_Attack: 在同一目标连续命中3次后造成更多伤害。6秒冷却。
			Lethal_Tempo: 提高攻击速度；命中数达到一定后发射一枚音符。
			Fleet_Footwork: 命中时回复生命，并获得短暂的移速提升。
			Conqueror: 连续命中造成更多伤害，并根据造成伤害进行治疗。
			Absorb_Life: 命中时治疗。
			Triumph: 击杀后回复生命并在击败Boss后获得额外的宝藏袋。
			Presence_of_Mind: 命中或击杀时恢复法力。
			Legend_Alacrity: 每层增加1.5%攻击速度（最多6层）。
			Legend_Haste: 每层减少药水冷却时间。
			Legend_Bloodline: 每层提供吸血，满层时有额外最大生命加成。
			Coup_de_Grace: 对低于40%生命的Boss增加大约8%伤害。
			Cut_Down: 对高于60%生命的Boss造成更多伤害。
			Last_Stand: 对Boss的伤害随失去生命而提升。
			Electrocute: 对同一目标连续命中3次触发额外伤害。
			Hail_of_Blades: 接下来的3次命中获得高额攻击速度。10秒冷却。
			Dark_Harvest: 对低生命目标造成额外伤害；1.75秒后收割灵魂。35秒冷却。
			Cheap_Shot: 对移动受损的目标造成额外伤害。4秒冷却。
			Taste_of_Blood: 未满血时命中回复16生命。20秒冷却。
			Sudden_Impact: 位移后进入准备状态，下一击造成额外伤害。
			Eyeball_Collection: 击杀累计最多10层，每层增加约0.8%伤害。
			Ravenous_Hunter: 每层给予少量吸血。
			Ingenious_Hunter: 每层减少药水冷却。
			Treasure_Hunter: 击杀时额外获得基于宝藏猎人层数的钱币。
			Relentless_Hunter: 在5秒内未受伤后，每层增加约3%移动速度。
			Summon_Aery: 召唤艾黎协助你。
			Arcane_Comet: 周围会有奥术彗星，魔法攻击命中时触发额外攻击效果。
			Phase_Rush: 对同一目标连续三次命中会短暂提高移动速度。
			Axiom_Arcanist: 增加4%法术伤害。
			Manaflow_Band: 每层增加5点最大法力（最多6层），命中有冷却。
			Nimbus_Cloak: 使用药水后短时间获得移动速度加成。
			Transcendence: 使用药水时减少药水冷却5%。
			Celerity: 增加约25%移动速度。
			Absolute_Focus: 生命>=70%时增加约10%法术伤害。
			Scorch: 命中额外造成10点伤害。8秒冷却。
			Waterwalking: 在水中获得约10%移动速度加成。
			Gathering_Storm: 每小时获得1%伤害增益。
			Grasp_of_the_Undying: 战斗中叠加一个层数（最多4层）；满层时对Boss的下一次普攻会治疗、造成魔法伤害并永久增加最大生命。
			Aftershock: 近战命中给予临时抗性；结束时释放魔法冲击波。20秒共享冷却。
			Guardian: 获得冰冻护盾的效果，当冰障触发时，立刻恢复120血并进入50s的冷却。
			Demolish: 靠近Boss会叠加一个层数，最多叠至6层；满层后下一击造成大量基于最大生命的伤害。35秒冷却。
			Font_of_Life: 命中时回复4点生命。10秒冷却。
			Shield_Bash: 防御>=50时增加5%伤害。
			Conditioning: 游戏8分钟后增加6点防御。
			Second_Wind: 受伤后每秒回复1点生命，持续5秒。
			Bone_Plating: 受伤后接下来的3次命中减伤6点。
			Overgrowth: 每分钟增加5点最大生命（最多+50）。
			Revitalize: 提高治疗效果10%。
			Unflinching: 受伤后短时间增加约10%移动速度。
			Glacial_Augment: 冷系伤害命中时造成75%减速。10秒冷却。
			Unsealed_Spellbook: 给予一个额外饰品栏。
			First_Strike: 触发后造成额外伤害，10秒冷却。
			Hextech_Flashtraption: 多次使用混沌传送杖不再进入混沌状态，转而消耗150法力。
			Magical_Footwear: 游戏8分钟后增加约10%移动速度。
			Cash_Back: 在商店购买物品时返还5%花费（每次购买上限50银）。
			Triple_Tonic: 使用药水后30分钟内增加14%伤害。
			Time_Warp_Tonic: 药水额外提供缓慢恢复效果。
			Biscuit_Delivery: 每20秒回复10点生命并恢复10点法力。
			Cosmic_Insight: 使用药水时减少10%药水冷却。
			Approach_Velocity: 靠近被减益的敌人时增加20%移动速度。
			Jack_of_All_Trades: 在10秒内触发三种伤害类型可获得短时间大幅伤害增益。10秒冷却。
		}
	}

	StatAnvil: {
		Title: 属性加成 - 选择一个碎片
		SilverLabel: 白银碎片（随机数值）
		GoldLabel: 黄金碎片（固定数值）
