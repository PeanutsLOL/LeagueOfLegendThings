UI: {
	Runes: {
		Label: {
			MainButton: Runes
			PanelTitle: Rune Selection
			ButtonLocked: Locked
			ButtonUnlocked: Unlocked
		}

		Path: {
			Precision: {
				Name: Precision
				Desc: Improved attacks and sustained damage.
			}

			Domination: {
				Name: Domination
				Desc: Burst damage and target access.
			}

			Sorcery: {
				Name: Sorcery
				Desc: Empowered abilities and resource manipulation.
			}

			Resolve: {
				Name: Resolve
				Desc: Durability and crowd control.
			}

			Inspiration: {
				Name: Inspiration
				Desc: Creative tools and rule bending.
			}
		}

		Desc: {
			Press_the_Attack: Deals more damage after 3 hits on the same target. 6s cooldown.
			Lethal_Tempo: Increase your ATK speed. Fires extra bullets after a few hits.
			Fleet_Footwork: Heals on hit, and a burst speed boost.
			Conqueror: Deals more damage after a few hits, then gets heal based on damage dealt.
			Absorb_Life: Heal on hit.
			Triumph: Heal on kill after boss fight. Earn an extra treasure bag.
			Presence_of_Mind: Restore mana on hit/kill.
			Legend_Alacrity: +1.5% attack speed per stack (max 6).
			Legend_Haste: Potion cooldown reduced per stack.
			Legend_Bloodline: Life steal per stack, bonus max life at full stacks.
			Coup_de_Grace: +8% damage to bosses below 40% HP.
			Cut_Down: Dealt more damage to bosses while it's above 60% HP.
			Last_Stand: Damage scales with missing health vs bosses.
			Electrocute: 3 hits on same target triggers bonus damage.
			Hail_of_Blades: +160% attack speed for next 3 hits. 10s cooldown.
			Dark_Harvest: Low HP target: bonus damage, souls after 1.75s. 35s cooldown.
			Cheap_Shot: Bonus damage vs crowd-controlled targets. 4s cooldown.
			Taste_of_Blood: Heal 16 on hit when not full HP. 20s cooldown.
			Sudden_Impact: Dash/teleport grants ready state. Next hit deals 40/140/240.
			Eyeball_Collection: Kills stack up to 10. +0.8% damage per stack.
			Ravenous_Hunter: Life steal 0.05% per hunter stack.
			Ingenious_Hunter: Potion cooldown -3% per hunter stack.
			Treasure_Hunter: Extra gold on kill based on hunter stacks.
			Relentless_Hunter: +3% move speed per hunter stack after 5s no damage.
			Summon_Aery: Summon Aery to help you.
			Arcane_Comet: An Arcane comet goes around you. Strike while you hit an enemy.
			Phase_Rush: Three consecutive hits on a target grant a short movement-speed burst.
			Axiom_Arcanist: +4% magic damage.
			Manaflow_Band: +5 max mana per stack (max 6), hit cooldown 20s.
			Nimbus_Cloak: After potion: +20% move speed for 2s.
			Transcendence: Potion cooldown reduced by 5% on use.
			Celerity: +25% move speed.
			Absolute_Focus: HP >=70%: +10% magic damage.
			Scorch: Extra 10 damage on hit. 8s cooldown.
			Waterwalking: In water: +10% move speed.
			Gathering_Storm: Every 1h: +1% damage stack.
			Grasp_of_the_Undying: Stack in combat (max 4); at 4 stacks, next basic attack on a boss heals, deals magic damage, and grants permanent max HP.
			Aftershock: Melee hits grant temporary resistance; when it ends, release a shockwave that deals magic damage. 20s shared CD.
			Guardian: When Ice Barrier is applied, instantly heal 120 and trigger a 50s cooldown.
			Demolish: Boss nearby stacks to 6. Next hit: 100 + 35% max HP. 35s cooldown.
			Font_of_Life: Heal 4 on hit. 10s cooldown.
			Shield_Bash: Defense >=50: +5% damage.
			Conditioning: After 8 minutes: +6 defense.
			Second_Wind: After damage: heal 1 per second for 5s.
			Bone_Plating: After damage: next 3 hits reduce by 6.
			Overgrowth: Every minute: +5 max life (max +50).
			Revitalize: Healing +10%.
			Unflinching: After damage: +10% move speed for 2s.
			Glacial_Augment: Cause 75% slow on hit with cold damage. 5s cooldown.
			Unsealed_Spellbook: Give an extra accessory slot, vanity slot and dye slot.
			First_Strike: After triggering: deal bonus damage, 10s cooldown.
			Hextech_Flashtraption: No Chaos State; Rod of Discord costs 150 mana.
			Magical_Footwear: After 8 minutes: +10% move speed.
			Cash_Back: Refund 5% of item cost when buying from shops (cap 50 silver per purchase).
			Triple_Tonic: After potion: +14% damage for 30 min.
			Time_Warp_Tonic: Potion grants extra slow heal of same amount.
			Biscuit_Delivery: Every 20s: heal 10 and restore 10 mana.
			Cosmic_Insight: Potion cooldown -10% on use.
			Approach_Velocity: Near debuffed enemies: +20% move speed.
			Jack_of_All_Trades: 3 damage types in 10s: +100% damage for 5s. 10s cooldown.
		}
	}
}
